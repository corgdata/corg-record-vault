      "devdoc": {
        "details": "The audit events themselves stay off-chain in the gateway's database.      Anchoring stores only a Merkle root over a contiguous range of events,      so later edits, insertions, or deletions inside an anchored range are      detectable by recomputing the root from the stored rows and comparing.      This contract is a companion to MedicalRecordsRegistry; it is not the      canonical registry and holds no consent state.",
        "kind": "dev",
        "methods": {},
        "title": "AuditAnchor",
        "version": 1
      },
      "userdoc": {
        "kind": "user",
        "methods": {
          "anchor(bytes32,uint64,uint64)": {
            "notice": "Anchor a Merkle root over the audit-event sequence range [fromSeq, toSeq]."
          }
        },
        "notice": "Tamper-evidence anchors for the Record Vault gateway audit log.",
        "version": 1
      }
